<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="@dimen/_12sdp"
    android:paddingEnd="@dimen/_12sdp"
    android:paddingTop="@dimen/_12sdp"
    android:paddingBottom="@dimen/_12sdp">

    <!-- Left: Avatar FrameLayout -->
    <FrameLayout
        android:id="@+id/flAvatar"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_52sdp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true">

        <!-- Contact photo -->
        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:contentDescription="@string/avatar"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Initials background -->
        <TextView
            android:id="@+id/tvInitials"
            android:layout_width="@dimen/_52sdp"
            android:layout_height="@dimen/_52sdp"
            android:background="@drawable/ic_round_bg"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold" />

        <!-- Selection checkmark overlay -->
        <ImageView
            android:id="@+id/ivSelected"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@string/selected"
            android:src="@drawable/ic_select"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Right side: date + unread badge -->
    <LinearLayout
        android:id="@+id/llRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/_4sdp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sub_color"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:background="@drawable/ic_round_badge"
            android:gravity="center"
            android:minWidth="@dimen/_18sdp"
            android:padding="@dimen/_3sdp"
            android:textColor="@android:color/white"
            android:textSize="@dimen/_10ssp"
            android:visibility="gone"
            app:backgroundTint="@color/app_color" />

    </LinearLayout>

    <!-- Center: Name + preview -->
    <LinearLayout
        android:id="@+id/llCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_toEndOf="@id/flAvatar"
        android:layout_toStartOf="@id/llRight"
        android:orientation="vertical">

        <!-- Name row with unread dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <!-- Unread dot indicator -->
            <View
                android:id="@+id/unread_dot"
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:background="@drawable/circle_dot"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Preview snippet -->
        <TextView
            android:id="@+id/tvPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sub_color"
            android:textSize="@dimen/_13ssp" />

    </LinearLayout>

</RelativeLayout>
