<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/_48sdp"
    android:paddingEnd="@dimen/_8sdp"
    android:paddingTop="@dimen/_2sdp"
    android:paddingBottom="@dimen/_2sdp">

    <!-- OTP Pill (shown when OTP detected) -->
    <TextView
        android:id="@+id/tvOtpPillOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_otp_pill"
        android:textColor="@color/app_color"
        android:textSize="@dimen/_11ssp"
        android:textStyle="bold"
        android:paddingStart="@dimen/_10sdp"
        android:paddingEnd="@dimen/_10sdp"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_4sdp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Message Bubble -->
    <FrameLayout
        android:id="@+id/bubbleOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="@drawable/bg_bubble_outgoing"
        android:elevation="@dimen/_1sdp">

        <TextView
            android:id="@+id/tvMessageOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_14ssp"
            android:padding="@dimen/_10sdp"
            android:maxWidth="250dp"
            android:lineSpacingExtra="@dimen/_2sdp" />
    </FrameLayout>

    <!-- Time and status row -->
    <LinearLayout
        android:id="@+id/llTimeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_4sdp">

        <TextView
            android:id="@+id/tvTimeOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sub_color"
            android:textSize="@dimen/_10ssp" />

        <ImageView
            android:id="@+id/ivStatus"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_4sdp"
            android:src="@drawable/ic_msg_sent"
            android:contentDescription="@string/status"
            app:tint="@color/sub_color" />
    </LinearLayout>

</LinearLayout>
