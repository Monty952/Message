<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/recycle_bin"
        app:titleTextColor="@color/title_color" />

    <!-- Info banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_8sdp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recycle_bin_retention_notice"
            android:textColor="@color/sub_color"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_16sdp" />

        <LinearLayout
            android:id="@+id/llEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_120sdp"
                android:src="@drawable/ic_nodata_bin"
                android:contentDescription="@string/recycle_bin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/recycle_bin_empty"
                android:textColor="@color/sub_color"
                android:textSize="@dimen/_15ssp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Empty Bin Button -->
    <Button
        android:id="@+id/btnEmptyBin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_46sdp"
        android:layout_margin="@dimen/_12sdp"
        android:backgroundTint="#FFD93025"
        android:text="@string/empty_recycle_bin"
        android:textColor="@color/white"
        android:textSize="@dimen/_14ssp"
        android:visibility="gone"
        style="@style/Widget.Material3.Button" />
</LinearLayout>
