<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/background"
            android:elevation="2dp"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/swipe_actions"
            app:titleTextColor="@color/title_color" />

        <!-- Swipe Right Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="@string/swipe_right_action"
            android:textColor="@color/app_color"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSwipeRight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp">

            <RadioButton
                android:id="@+id/rbRightRead"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/action_mark_read_unread"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbRightArchive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/archive"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbRightDelete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/delete"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbRightNone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/action_none"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@color/divider" />

        <!-- Swipe Left Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_16sdp"
            android:paddingBottom="@dimen/_8sdp"
            android:text="@string/swipe_left_action"
            android:textColor="@color/app_color"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgSwipeLeft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp">

            <RadioButton
                android:id="@+id/rbLeftDelete"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/delete"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbLeftArchive"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/archive"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbLeftRead"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/action_mark_read_unread"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />

            <RadioButton
                android:id="@+id/rbLeftNone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:buttonTint="@color/app_color"
                android:text="@string/action_none"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_14ssp" />
        </RadioGroup>

    </LinearLayout>
</ScrollView>
