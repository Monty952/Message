<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/background"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/backup_restore"
        app:titleTextColor="@color/title_color" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_20sdp"
            android:paddingVertical="@dimen/_24sdp">

            <ImageView
                android:layout_width="@dimen/_140sdp"
                android:layout_height="@dimen/_140sdp"
                android:src="@drawable/ic_backup_header"
                android:contentDescription="@string/backup_restore" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:gravity="center"
                android:text="@string/backup_restore_msg"
                android:textColor="@color/title_color"
                android:textSize="@dimen/_17ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_8sdp"
                android:gravity="center"
                android:text="@string/backup_content"
                android:textColor="@color/sub_color"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/tvLastBackup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:text="@string/no_backup_found"
                android:textColor="@color/sub_color"
                android:textSize="@dimen/_12ssp" />

            <!-- Backup Button -->
            <Button
                android:id="@+id/btnBackup"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginTop="@dimen/_28sdp"
                android:backgroundTint="@color/app_color"
                android:text="@string/backup_now"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                style="@style/Widget.Material3.Button" />

            <!-- Restore Button -->
            <Button
                android:id="@+id/btnRestore"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_48sdp"
                android:layout_marginTop="@dimen/_12sdp"
                android:text="@string/restore_messages"
                android:textColor="@color/app_color"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
